{
  "name": "nutricare-backend",
  "version": "1.0.0",
  "description": "Backend API untuk NutriCare - Sistem Informasi Gizi Pasien",
  "main": "dist/src/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "build:api": "tsc --project tsconfig.build.json",
    "start": "node dist/src/main.js",
    "test": "vitest",
    "test:run": "vitest run",
    "check:frontend": "cd .. && sha256sum -c docs/frontend-checksums.txt",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "seed:auth": "tsx seeds/create-auth-users.ts",
    "seed:master": "node seeds/master-menu.mjs --apply --emit",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "keywords": [
    "nutricare",
    "gizi",
    "hospital",
    "nutrition"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "pg": "^8.12.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
