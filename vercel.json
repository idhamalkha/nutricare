{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "cd server && npm ci --include=dev && npm run build:api",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
